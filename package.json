{
  "name": "gym-management",
  "version": "1.0.0",
  "description": "GymPass style app.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "restart": "npm run build && npm run start",
    "build": "./node_modules/.bin/prisma generate && tsup-node src/server.ts --format esm --minify",
    "test": "vitest --project unit",
    "test:e2e": "vitest --project e2e",
    "test:watch": "vitest --watch --project unit",
    "test:e2e:watch": "vitest --watch --project e2e",
    "test:coverage": "vitest --coverage",
    "format": "biome format --write",
    "lint": "biome lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorps/gym-access.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/joaovitorps/gym-access/issues"
  },
  "homepage": "https://github.com/joaovitorps/gym-access#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "25.5.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/bcryptjs": "2.4.6",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "eslint": "10.8.1",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  }
}
