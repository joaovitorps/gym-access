  "type": "module",
  "bugs": {
    "url": "https://github.com/joaovitorps/gym-access/issues"
  },
  "homepage": "https://github.com/joaovitorps/gym-access#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.5",
    "prisma": "6.19.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "2.4.6",
    "bcryptjs": "3.0.3",
    "dotenv": "17.3.1",
    "eslint": "10.1.0",
    "fastify": "5.8.4",
    "uuid": "14.0.0",
    "zod": "4.3.6"
  }
}
