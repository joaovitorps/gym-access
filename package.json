{
  "name": "gym-management",
  "version": "1.0.0",
  "description": "GymPass style app.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx watch build/server.cjs",
    "build": "tsup src --out-dir build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "format": "biome format --write",
    "lint": "biome lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorps/gym-access.git"
  },
  "keywords": [],
  "author": "",
